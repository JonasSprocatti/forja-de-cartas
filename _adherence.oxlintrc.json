{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/card/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/mana/**",
              "ui_kits/forge/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Beleren Bold|Cinzel|EB Garamond|Spectral|Bitter))/i]",
        "message": "Font not provided by the design system. Available: Beleren Bold, Cinzel, EB Garamond, Spectral, Bitter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|pub|priv|neutral)$/]",
        "message": "<Badge> variant must be one of 'gold' | 'pub' | 'priv' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|disabled|href|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, disabled, href, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|ghost|rune)$/]",
        "message": "<Button> variant must be one of 'gold' | 'ghost' | 'rune'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|manaCost|type|art|rules|flavor|pt|rarity|color|foil|frame|frameBase|artist|collector|size|tilt|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: name, manaCost, type, art, rules, flavor, pt, rarity, color, foil, frame, frameBase, artist, collector, size, tilt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:comum|incomum|rara|mítica)$/]",
        "message": "<Card> rarity must be one of 'comum' | 'incomum' | 'rara' | 'mítica'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:auto|W|U|B|R|G|multi|C)$/]",
        "message": "<Card> color must be one of 'auto' | 'W' | 'U' | 'B' | 'R' | 'G' | 'multi' | 'C'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm|xs)$/]",
        "message": "<Card> size must be one of 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropzone'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|small|accept|onFiles|key|ref|className|style|children)$/]",
        "message": "<Dropzone> doesn't accept that prop. Declared props: icon, label, small, accept, onFiles."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<FieldLabel> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManaCost'] > JSXAttribute > JSXIdentifier[name!=/^(?:cost|symbols|size|key|ref|className|style|children)$/]",
        "message": "<ManaCost> doesn't accept that prop. Declared props: cost, symbols, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManaCost'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ManaCost> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManaPip'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|size|key|ref|className|style|children)$/]",
        "message": "<ManaPip> doesn't accept that prop. Declared props: symbol, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManaPip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ManaPip> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RarityGem'] > JSXAttribute > JSXIdentifier[name!=/^(?:rarity|key|ref|className|style|children)$/]",
        "message": "<RarityGem> doesn't accept that prop. Declared props: rarity."
      },
      {
        "selector": "JSXOpeningElement[name.name='RarityGem'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:comum|incomum|rara|mítica|common|uncommon|rare|mythic)$/]",
        "message": "<RarityGem> rarity must be one of 'comum' | 'incomum' | 'rara' | 'mítica' | 'common' | 'uncommon' | 'rare' | 'mythic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegOption> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|icon|children|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: type, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:neutral|ok|err)$/]",
        "message": "<Toast> type must be one of 'neutral' | 'ok' | 'err'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|onChange|icon|children|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: on, onChange, icon, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
