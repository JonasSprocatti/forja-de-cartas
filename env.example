# ============================================================
# Forja de Cartas — variáveis de ambiente (defina na Vercel)
# Copie os NOMES; preencha os valores no painel (Settings → Environment Variables).
# NUNCA versione um .env com valores reais.
# ============================================================

# --- Supabase (URL e ANON são públicos; SERVICE_ROLE é SEGREDO) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=seu_service_role_SECRETO   # só no servidor — nunca no front

# --- IA (Google Gemini) — SEGREDO ---
GEMINI_API_KEY=sua_chave_do_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash                # opcional
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image    # opcional

# --- Stripe (VIP) — SK e WEBHOOK são SEGREDOS ---
STRIPE_SECRET_KEY=sk_live_ou_sk_test
STRIPE_PRICE_ID=price_xxx
STRIPE_MODE=subscription                     # ou "payment"
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AdSense (públicos) ---
ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_SLOTS={"adTop":"123","adBottom":"456"}
